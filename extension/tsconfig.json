{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome", "vite/client"],
    "paths": { "@meritio/shared": ["../shared/src/index.ts"] }
  },
  "include": ["src", "manifest.ts", "vite.config.ts"]
}
